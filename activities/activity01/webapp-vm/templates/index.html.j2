<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title | e }}</title>
<style>
  :root { --bg: #0d1117; --card: #161b22; --line: #30363d; --text: #e6edf3; --muted: #9da7b3; --accent: #58a6ff; --done: #3fb950; }
  * { box-sizing: border-box; }
  body { margin: 0; min-height: 100vh; background: var(--bg); color: var(--text);
         font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
         display: flex; align-items: center; justify-content: center; padding: 24px; }
  main { width: 100%; max-width: 760px; }
  h1 { font-size: 1.6rem; margin: 0 0 4px; word-break: break-word; }
  .sub { color: var(--muted); margin: 0 0 24px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 12px; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; }
  .label { color: var(--muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .value { margin-top: 6px; font-size: 1.05rem; word-break: break-all; }
  .journey { display: flex; gap: 8px; margin-top: 24px; flex-wrap: wrap; }
  .step { flex: 1 1 140px; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--line);
          background: var(--card); font-size: 0.9rem; color: var(--muted); }
  .step.done { border-color: var(--done); color: var(--text); }
  .step.done::before { content: "\2713  "; color: var(--done); }
  .step.next::before { content: "\2192  "; color: var(--muted); }
</style>
</head>
<body>
<main>
  <h1>{{ page_title | e }}</h1>
  <p class="sub">Served by nginx on your VM, deployed by AAP</p>
  <div class="grid">
    <div class="card"><div class="label">Host</div><div class="value">{{ ansible_facts['hostname'] | e }}</div></div>
    <div class="card"><div class="label">Port</div><div class="value">{{ nginx_port | e }}</div></div>
  </div>
  <div class="journey">
    <div class="step done">VM</div>
    <div class="step next">OpenShift</div>
    <div class="step next">Configuration as Code</div>
    <div class="step next">Event-Driven Ansible</div>
  </div>
</main>
</body>
</html>
