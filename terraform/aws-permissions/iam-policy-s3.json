{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "BucketLevel",
			"Effect": "Allow",
			"Action": [
				"s3:ListBucket",
				"s3:GetBucketLocation"
			],
			"Resource": "arn:aws:s3:::aap-hub-cluster-gvcw9.gvcw9.sandbox2320"
		},
		{
			"Sid": "ObjectLevel",
			"Effect": "Allow",
			"Action": [
				"s3:GetObject",
				"s3:PutObject",
				"s3:DeleteObject"
			],
			"Resource": "arn:aws:s3:::aap-hub-cluster-gvcw9.gvcw9.sandbox2320/*"
		}
	]
}